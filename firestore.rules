rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper
    function isSignedIn() {
      return request.auth != null;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostic / Test Connection
    match /test/connection {
      allow read: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;

      // Bookmarked Ayahs
      match /ayahBookmarks/{bookmarkId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // Adhkar Progress
      match /adhkarProgress/{progressId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Secondary Profiles (Searchable index by email)
    match /profiles/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        (request.resource != null && request.resource.data.uid == request.auth.uid) || 
        (resource != null && resource.data.uid == request.auth.uid)
      );
    }

    // NoorTalk Feed Posts
    match /posts/{postId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Chat Rooms and Messages
    match /rooms/{roomId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // AI Conversations
    match /ai_conversations/{convId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if isSignedIn() && (
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    // Marketplace Listings
    match /listings/{listingId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid;
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read, write: if isSignedIn();
    }
  }
}
