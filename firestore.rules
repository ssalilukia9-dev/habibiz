rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ssalilukia9@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*')) ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*hamloria.*')) ||
        request.auth.uid == 'hamloria' ||
        request.auth.uid == '0207' ||
        request.auth.uid == '0214' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Diagnostic / Test Connection
    match /test/connection {
      allow read: if true;
    }

    // Secure Admin Configuration & Overseer Access Settings
    match /admin_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Profiles & Admin Overrides
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Bookmarked Ayahs
      match /ayahBookmarks/{bookmarkId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Adhkar Progress
      match /adhkarProgress/{progressId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Voice Reflections
      match /voiceReflections/{reflectionId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }

      // Downloaded Surahs
      match /downloadedSurahs/{surahId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Secondary Profiles (Searchable index by email)
    match /profiles/{email} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        (request.resource != null && request.resource.data.uid == request.auth.uid) || 
        (resource != null && resource.data.uid == request.auth.uid) ||
        isAdmin()
      );
    }

    // Announcements / Global Broadcasts
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Activity Logs (User Registrations, Hasanat Redemptions)
    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // NoorTalk Feed Posts
    match /posts/{postId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Chat Rooms and Messages
    match /rooms/{roomId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // AI Conversations
    match /ai_conversations/{convId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid) ||
        isAdmin()
      );

      match /messages/{msgId} {
        allow read, write: if isSignedIn();
      }
    }

    // Marketplace Listings
    match /listings/{listingId} {
      allow read, create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Friend Requests
    match /friend_requests/{requestId} {
      allow read, write: if isSignedIn();
    }
  }
}
