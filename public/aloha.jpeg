<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 800" width="100%" height="100%">
  <defs>
    <linearGradient id="creamBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FAF6F0"/>
      <stop offset="50%" stop-color="#F4EFE6"/>
      <stop offset="100%" stop-color="#EDE6D8"/>
    </linearGradient>
    <linearGradient id="goldWave" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#D4A373"/>
      <stop offset="50%" stop-color="#C58F54"/>
      <stop offset="100%" stop-color="#A97138"/>
    </linearGradient>
    <linearGradient id="goldWaveLight" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#E2B789"/>
      <stop offset="100%" stop-color="#C58F54"/>
    </linearGradient>
    <linearGradient id="navyWaveDark" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0F3B56"/>
      <stop offset="50%" stop-color="#0A2A3F"/>
      <stop offset="100%" stop-color="#061C2C"/>
    </linearGradient>
    <linearGradient id="navyWaveMid" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#1B4D6E"/>
      <stop offset="100%" stop-color="#0D3049"/>
    </linearGradient>
    <filter id="subtleShadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#000000" flood-opacity="0.08"/>
    </filter>
  </defs>

  <!-- Background Linen Cream -->
  <rect width="800" height="800" fill="url(#creamBg)"/>

  <!-- Subtle Ambient Glow -->
  <circle cx="400" cy="400" r="300" fill="#FFFFFF" opacity="0.4" filter="blur(40px)"/>

  <!-- Logo Group Center Wrapper -->
  <g transform="translate(140, 310)" filter="url(#subtleShadow)">
    
    <!-- Waves Emblem -->
    <g transform="translate(0, 0)">
      <!-- Top Gold Wave Upper -->
      <path d="M 90 28 C 115 12, 145 10, 175 22 C 145 28, 120 38, 95 55 C 75 42, 82 32, 90 28 Z" fill="url(#goldWaveLight)" />
      
      <!-- Middle Gold Wave Main -->
      <path d="M 65 52 C 95 32, 135 30, 180 50 C 145 60, 105 70, 70 85 C 55 72, 60 58, 65 52 Z" fill="url(#goldWave)" />
      
      <!-- Upper Navy Wave -->
      <path d="M 22 88 C 50 68, 95 68, 140 92 C 165 106, 175 106, 175 106 C 140 118, 95 116, 55 98 C 38 90, 25 88, 22 88 Z" fill="url(#navyWaveMid)" />
      
      <!-- Lower Deep Navy Wave -->
      <path d="M 0 118 C 35 94, 85 96, 130 126 C 160 144, 175 142, 175 142 C 135 158, 80 152, 35 128 C 15 118, 5 118, 0 118 Z" fill="url(#navyWaveDark)" />
    </g>

    <!-- ALOHA Wordmark -->
    <text x="210" y="112" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" font-size="68" font-weight="900" letter-spacing="4" fill="#0A2A3F">
      ALOHA
    </text>

    <!-- Group of Companies Subtitle -->
    <text x="212" y="152" font-family="system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif" font-size="21" font-weight="600" letter-spacing="1.2" fill="#0A2A3F" opacity="0.92">
      Group of Companies
    </text>
  </g>

  <!-- Luxury Footer Text -->
  <text x="400" y="740" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="11" font-weight="800" letter-spacing="4" fill="#8C7A6B" text-transform="uppercase">
    PRECISION &bull; INNOVATION &bull; EXCELLENCE
  </text>
</svg>
