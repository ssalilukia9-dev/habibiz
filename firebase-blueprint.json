{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "emailVerified": { "type": "boolean" },
        "hasanat": { "type": "number" },
        "isPremium": { "type": "boolean" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "hasanat"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["text", "image"] }
      },
      "required": ["senderId", "text", "timestamp"]
    },
    "ChatRoom": {
      "title": "ChatRoom",
      "description": "A private or group chat room",
      "type": "object",
      "properties": {
        "participants": { "type": "array", "items": { "type": "string" } },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["private", "group"] },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participants", "type", "updatedAt"]
    },
    "AIConversation": {
      "title": "AIConversation",
      "description": "A conversation with the Islamic Companion",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "updatedAt", "createdAt"]
    },
    "AIMessage": {
      "title": "AIMessage",
      "description": "A message in an AI conversation",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "Listing": {
      "title": "Listing",
      "description": "A marketplace listing",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "brand": { "type": "string" },
        "condition": { "type": "string" },
        "videoUrl": { "type": "string" },
        "contactInfo": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "specifications": { "type": "string" },
        "shippingEstimate": { "type": "string" },
        "sellerId": { "type": "string" },
        "sellerName": { "type": "string" },
        "sellerPhoto": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "sold", "deleted"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "rating": { "type": "number" }
      },
      "required": ["title", "price", "sellerId", "status", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "A social connection request between users",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "fromPhoto": { "type": "string" },
        "toId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromId", "toId", "status", "createdAt"]
    },
    "ChatRequest": {
      "title": "ChatRequest",
      "description": "A request to start a private chat",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "fromName": { "type": "string" },
        "fromPhoto": { "type": "string" },
        "toId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromId", "toId", "status", "createdAt"]
    },
    "AyahBookmark": {
      "title": "AyahBookmark",
      "description": "A bookmarked Quranic verse",
      "type": "object",
      "properties": {
        "number": { "type": "number" },
        "surahNumber": { "type": "number" },
        "numberInSurah": { "type": "number" },
        "text": { "type": "string" },
        "translation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["number", "surahNumber", "numberInSurah", "text", "createdAt"]
    },
    "AdhkarProgress": {
      "title": "AdhkarProgress",
      "description": "User progress for daily adhkar",
      "type": "object",
      "properties": {
        "adhkarId": { "type": "string" },
        "completed": { "type": "boolean" },
        "lastCompletedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adhkarId", "completed", "lastCompletedAt"]
    },
    "VoiceReflection": {
      "title": "VoiceReflection",
      "description": "A user's voice recorded reflection and suggested verses",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "verses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "surah": { "type": "number" },
              "ayah": { "type": "number" },
              "surahName": { "type": "string" },
              "text": { "type": "string" },
              "translation": { "type": "string" },
              "relevance": { "type": "string" }
            }
          }
        }
      },
      "required": ["text", "createdAt"]
    },
    "DownloadedSurah": {
      "title": "DownloadedSurah",
      "description": "A surah downloaded by the user",
      "type": "object",
      "properties": {
        "surahNumber": { "type": "number" },
        "surahName": { "type": "string" },
        "reciterId": { "type": "string" },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["surahNumber", "syncedAt"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Global announcement published by admins",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "target": { "type": "string" },
        "sentBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "createdAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Real-time system activity event records including user registrations, hasanat redemptions, and spiritual milestones",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["registration", "redemption", "hasanat", "streak", "quran", "dhikr", "admin", "prayer"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userEmail": { "type": "string" },
        "amount": { "type": "number" },
        "badge": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "message", "createdAt"]
    },
    "AdminConfig": {
      "title": "AdminConfig",
      "description": "Secure administration and overseer access configuration",
      "type": "object",
      "properties": {
        "allowedAdminEmails": { "type": "array", "items": { "type": "string" } },
        "allowedAdminUids": { "type": "array", "items": { "type": "string" } },
        "adminPasscode": { "type": "string" },
        "superAdminEmails": { "type": "array", "items": { "type": "string" } },
        "maintenanceMode": { "type": "boolean" },
        "allowGuestRegistrations": { "type": "boolean" },
        "requireSubscriptionForUmmah": { "type": "boolean" },
        "systemBroadcastNotice": { "type": "string" },
        "securityRoles": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastUpdatedBy": { "type": "string" }
      },
      "required": ["allowedAdminEmails", "adminPasscode"]
    },
    "KhatamVideo": {
      "title": "KhatamVideo",
      "description": "A video resource for the Khatam Journey",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "embedUrl": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "category": { "type": "string" },
        "speaker": { "type": "string" },
        "description": { "type": "string" },
        "duration": { "type": "string" },
        "juzNumber": { "type": "number" },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "addedBy": { "type": "string" }
      },
      "required": ["title", "url", "createdAt"]
    }
  },
  "firestore": {
    "/khatam_videos/{videoId}": {
      "schema": "KhatamVideo",
      "description": "Curated videos for the Khatam Journey"
    },
    "/admin_config/{configId}": {
      "schema": "AdminConfig",
      "description": "Secure admin configuration and overseer authorization settings"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Real-time system activity logs and event feeds"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Global broadcasts sent to app users"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User records"
    },
    "/users/{userId}/adhkarProgress/{progressId}": {
      "schema": "AdhkarProgress",
      "description": "User daily adhkar completion tracking"
    },
    "/users/{userId}/ayahBookmarks/{bookmarkId}": {
      "schema": "AyahBookmark",
      "description": "User saved ayahs"
    },
    "/users/{userId}/voiceReflections/{reflectionId}": {
      "schema": "VoiceReflection",
      "description": "User recorded voice reflections"
    },
    "/users/{userId}/downloadedSurahs/{surahId}": {
      "schema": "DownloadedSurah",
      "description": "User offline-downloaded surahs"
    },
    "/rooms/{roomId}": {
      "schema": "ChatRoom",
      "description": "Chat rooms"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Messages within a room"
    },
    "/ai_conversations/{convId}": {
      "schema": "AIConversation",
      "description": "Historical AI chats"
    },
    "/ai_conversations/{convId}/messages/{msgId}": {
      "schema": "AIMessage",
      "description": "Messages in an AI chat"
    },
    "/listings/{listingId}": {
      "schema": "Listing",
      "description": "Marketplace listings"
    },
    "/chat_requests/{requestId}": {
      "schema": "ChatRequest",
      "description": "Pending chat requests"
    },
    "/friend_requests/{requestId}": {
      "schema": "FriendRequest",
      "description": "User connection requests"
    }
  }
}
