# Firebase configuration (obtained via set_up_firebase tool)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Gemini API Configuration
# Server-side Gemini API key (for hosted backend proxy)
GEMINI_API_KEY=

# Client-side Gemini API key (for compiled standalone apps, Capacitor, APK, iOS, or static deployments)
VITE_GEMINI_API_KEY=

# Optional custom backend URL for compiled standalone apps (defaults to auto-detection)
VITE_PRODUCTION_API_URL=

# OneSignal Web Push Configuration
VITE_ONESIGNAL_APP_ID=
